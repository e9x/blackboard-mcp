# ─────────────────────────────────────────────────────────────
#  Blackboard MCP — Configuration
#  Works with ANY university that uses Blackboard Learn.
# ─────────────────────────────────────────────────────────────
#
# Copy this file to .env and set BB_BASE_URL to your university's
# Blackboard address.
#
# You do NOT need to put your username or password here.
# Authentication is handled by logging in through a browser window.
#
# NEVER commit your .env file to git.
# ─────────────────────────────────────────────────────────────

# Your university's Blackboard URL (no trailing slash).
# Examples:
#   BB_BASE_URL=https://blackboard.myuniversity.edu
#   BB_BASE_URL=https://learn.myuni.edu.au
#   BB_BASE_URL=https://lms.myschool.ac.uk
BB_BASE_URL=

# Blackboard interface: 'ultra' (default) or 'classic'
# Auto-detected by the setup wizard — you usually don't need to change this.
BB_INTERFACE=ultra

# Where to store your session cookie (outside the repo, in your home dir).
BB_SESSION_CACHE=~/.bb_mcp_session.json
